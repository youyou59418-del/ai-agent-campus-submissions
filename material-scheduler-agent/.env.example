# Offline mock: no configuration required. This file is NOT auto-loaded.
# For real mode, set variables in your shell. Never commit real keys.
DASHSCOPE_API_KEY=
AGENT_KEY_ENV=DASHSCOPE_API_KEY
AGENT_MODEL=qwen3.8-27b
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set to 1 ONLY after enabling and verifying provider-console protection for every candidate.
# The program cannot enable or independently verify that billing setting.
AGENT_FREE_ONLY_CONFIRMED=0
# Optional ordered fallback list, restricted to models protected in the console:
# AGENT_MODELS=qwen3.8-27b,qwen-plus
# Only AllocationQuota.FreeTierOnly triggers automatic fallback; never turns protection off.
# Explicit alternative: caller selects model and handles quota failures manually.
# Does NOT assert console protection is enabled:
# AGENT_QUOTA_POLICY=user_managed
